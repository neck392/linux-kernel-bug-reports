--- a/drivers/usb/gadget/udc/dummy_hcd.c
+++ b/drivers/usb/gadget/udc/dummy_hcd.c
@@ -39,6 +39,7 @@
 #include <linux/usb/gadget.h>
 #include <linux/usb/hcd.h>
 #include <linux/scatterlist.h>
+#include <linux/workqueue.h>
 
 #include <asm/byteorder.h>
 #include <linux/io.h>
@@ -100,6 +101,22 @@ struct dummy_request {
 	struct usb_request		req;
 };
 
+struct dummy_crosscpu_giveback {
+	struct usb_ep		*ep;
+	struct usb_request	*req;
+};
+
+static long dummy_crosscpu_giveback(void *info)
+{
+	struct dummy_crosscpu_giveback *giveback = info;
+	unsigned long flags;
+
+	local_irq_save(flags);
+	usb_gadget_giveback_request(giveback->ep, giveback->req);
+	local_irq_restore(flags);
+	return 0;
+}
+
 static inline struct dummy_ep *usb_ep_to_dummy_ep(struct usb_ep *_ep)
 {
 	return container_of(_ep, struct dummy_ep, ep);
@@ -782,12 +799,24 @@ static int dummy_dequeue(struct usb_ep *_ep, struct usb_request *_req)
 	}
 
 	if (retval == 0) {
+		struct dummy_crosscpu_giveback giveback = {
+			.ep = _ep,
+			.req = _req,
+		};
+		int cpu;
+
 		dev_dbg(udc_dev(dum),
 				"dequeued req %p from %s, len %d buf %p\n",
 				req, _ep->name, _req->length, _req->buf);
-		spin_unlock(&dum->lock);
-		usb_gadget_giveback_request(_ep, _req);
-		spin_lock(&dum->lock);
+		spin_unlock_irqrestore(&dum->lock, flags);
+		cpu = cpumask_any_but(cpu_online_mask, raw_smp_processor_id());
+		if (cpu < nr_cpu_ids && in_task() && !irqs_disabled()) {
+			if (work_on_cpu(cpu, dummy_crosscpu_giveback, &giveback))
+				dummy_crosscpu_giveback(&giveback);
+		} else {
+			dummy_crosscpu_giveback(&giveback);
+		}
+		spin_lock_irqsave(&dum->lock, flags);
 	}
 	spin_unlock_irqrestore(&dum->lock, flags);
 	return retval;
